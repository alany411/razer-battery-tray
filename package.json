{
  "name": "razer-battery-tray",
  "version": "0.1.0",
  "private": true,
  "description": "Windows tray app showing the battery level of a Razer DeathAdder V3 Pro",
  "author": "Alan Yang",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run"
  },
  "dependencies": {
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "node-hid"
    ]
  }
}
